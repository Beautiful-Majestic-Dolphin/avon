<service>
  <id>avon-agent</id>
  <name>AVON Agent</name>
  <description>AVON Endpoint Agent with hardware-backed identity</description>
  <executable>C:\Program Files\AVON\avon-agent.exe</executable>
  <arguments>run</arguments>
  <logmode>rotate</logmode>
  <serviceaccount>
    <domain>NT SERVICE</domain>
    <user>avon-agent</user>
  </serviceaccount>
</service>
