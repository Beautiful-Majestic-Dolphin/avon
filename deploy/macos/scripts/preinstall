#!/bin/bash
# Stop both daemons before the payload is replaced. Neither may be running when
# their binary changes underneath them.
set -e

for label in ai.avon.agent ai.avon.helper; do
    plist="/Library/LaunchDaemons/$label.plist"
    if [ -f "$plist" ]; then
        launchctl bootout "system/$label" 2>/dev/null || true
    fi
done

for proc in avon-agent avon-agent-helper; do
    if pgrep -x "$proc" >/dev/null 2>&1; then
        pkill -x "$proc" 2>/dev/null || true
    fi
done
sleep 1
exit 0
