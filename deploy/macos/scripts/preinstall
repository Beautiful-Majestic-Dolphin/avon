#!/bin/bash
# AVON Agent macOS pre-install script
# Stops the existing agent service before upgrading

set -e

PLIST_PATH="/Library/LaunchDaemons/ai.avon.agent.plist"
SERVICE_LABEL="ai.avon.agent"

echo "AVON Agent: Running pre-install..."

# Stop existing service if running
if [ -f "$PLIST_PATH" ]; then
    echo "Stopping existing AVON agent service..."
    if launchctl list "$SERVICE_LABEL" &>/dev/null; then
        launchctl bootout system "$PLIST_PATH" 2>/dev/null || true
    fi
fi

# Kill any lingering agent processes
if pgrep -x avon-agent &>/dev/null; then
    echo "Stopping lingering avon-agent processes..."
    pkill -x avon-agent 2>/dev/null || true
    sleep 1
fi

echo "AVON Agent: Pre-install complete."
exit 0
