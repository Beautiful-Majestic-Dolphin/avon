<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.avon.agent</string>

    <!-- The agent is unprivileged: everything that needs root is in the helper. -->
    <key>UserName</key>
    <string>_avon</string>
    <key>GroupName</key>
    <string>wheel</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/avon-agent</string>
        <string>run</string>
        <string>--config</string>
        <string>/Library/Application Support/AVON/agent.toml</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>WorkingDirectory</key>
    <string>/Library/Application Support/AVON</string>

    <key>StandardOutPath</key>
    <string>/Library/Logs/AVON/agent.log</string>

    <key>StandardErrorPath</key>
    <string>/Library/Logs/AVON/agent-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- RUST_LOG is what the binary reads; AVON_LOG_LEVEL was never consumed. -->
        <key>RUST_LOG</key>
        <string>info</string>
        <key>AVON_HELPER_SOCKET</key>
        <string>/var/run/avon/helper.sock</string>
    </dict>

    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>

    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
