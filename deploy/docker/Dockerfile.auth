# AVON Auth Service Dockerfile
# Multi-stage build for minimal runtime image

# Stage 1: Build
FROM rust:1.75-bookworm AS builder

# Install protobuf compiler for proto compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY proto/ proto/

# Build release binary
RUN cargo build --release --package avon-auth

# Stage 2: Runtime
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -u 1000 -m avon

# Copy binary from builder
COPY --from=builder /build/target/release/avon-auth /usr/local/bin/avon-auth

# Copy migrations
COPY --from=builder /build/crates/avon-auth/migrations /app/migrations

# Set ownership
RUN chown -R avon:avon /usr/local/bin/avon-auth /app

# Switch to non-root user
USER avon

WORKDIR /app

# Expose gRPC port and health check port
EXPOSE 50051 8080

# Health check using the health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/ || exit 1

# Run the auth service
ENTRYPOINT ["/usr/local/bin/avon-auth"]
