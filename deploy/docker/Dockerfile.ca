# AVON Certificate Authority Service Dockerfile
# Multi-stage build for minimal runtime image

# Stage 1: Build
FROM rust:1.96-bookworm AS builder

# Install protobuf compiler for proto compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY proto/ proto/

# Build release binary
RUN cargo build --release --package avon-ca

# Stage 2: Runtime
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -u 1000 -m avon

# Create data directory for keys
RUN mkdir -p /data && chown avon:avon /data

# Copy binary from builder
COPY --from=builder /build/target/release/avon-ca /usr/local/bin/avon-ca

# Copy migrations
COPY migrations/ /app/migrations/

# Set ownership
RUN chown -R avon:avon /usr/local/bin/avon-ca /app

# Switch to non-root user
USER avon

WORKDIR /app

# Expose gRPC port
EXPOSE 50052

# Environment variables
ENV CA_ROOT_KEY_PATH=/data/root.key
ENV CA_INTERMEDIATE_KEY_PATH=/data/intermediate.key
ENV CA_CERT_LIFETIME_SECS=3600
ENV CA_OCSP_LIFETIME_SECS=3600

# Run the CA service
ENTRYPOINT ["/usr/local/bin/avon-ca"]
