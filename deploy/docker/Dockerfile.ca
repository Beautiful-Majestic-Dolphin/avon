# AVON Certificate Authority Service Dockerfile
# Multi-stage build for minimal runtime image

# Stage 1: Build
FROM rust:1.75-bookworm AS builder

WORKDIR /build

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

# Build release binary
RUN cargo build --release --package avon-ca

# Stage 2: Runtime
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -u 1000 -m avon

# Copy binary from builder
COPY --from=builder /build/target/release/avon-ca /usr/local/bin/avon-ca

# Set ownership
RUN chown avon:avon /usr/local/bin/avon-ca

# Switch to non-root user
USER avon

# Expose gRPC port
EXPOSE 50052

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD /usr/local/bin/avon-ca --health-check || exit 1

# Run the CA service
ENTRYPOINT ["/usr/local/bin/avon-ca"]
