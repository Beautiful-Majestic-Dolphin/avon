# AVON Agent Dockerfile
# Multi-stage build for minimal runtime image

# Stage 1: Build
FROM rust:1.94-bookworm AS builder

# Install protobuf compiler for proto compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY proto/ proto/

# Build release binary
RUN cargo build --release --package avon-agent

# Stage 2: Runtime
FROM debian:bookworm-slim

# Install runtime dependencies including iproute2 for TUN device setup
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    iproute2 \
    iptables \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user (but agent needs root for TUN device)
RUN useradd -u 1000 -m avon

# Copy binary from builder
COPY --from=builder /build/target/release/avon-agent /usr/local/bin/avon-agent

# Create data directory
RUN mkdir -p /var/lib/avon && chown avon:avon /var/lib/avon

# Create config directory
RUN mkdir -p /etc/avon && chown avon:avon /etc/avon

# Note: Agent runs as root initially to create TUN device, then drops privileges
# In E2E tests, we run as root for simplicity

# Expose control API port (for E2E test control)
EXPOSE 8090

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8090/health || exit 1

# Run the agent
ENTRYPOINT ["/usr/local/bin/avon-agent"]
CMD ["run"]
