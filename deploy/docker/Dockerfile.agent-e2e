# syntax=docker/dockerfile:1.7
# AVON agent e2e image: avon-agent + iproute2 + curl + iperf3 + python3
# Runs as root with NET_ADMIN and /dev/net/tun — e2e only.
ARG RUST_VERSION=1.93.0
FROM rust:${RUST_VERSION}-bookworm AS builder
ARG BIN=avon-agent
# The TPM provider links tpm2-tss, which cargo finds through pkg-config.
ARG FEATURES=tpm2
RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler=3.21.12-3+deb12u1 libtss2-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY proto ./proto
COPY migrations ./migrations
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/build/target,sharing=locked \
    cargo build --release --locked -p avon-agent --bin "${BIN}" --features "${FEATURES}" \
 && cp "target/release/${BIN}" "/${BIN}"

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    iproute2 curl iperf3 python3 python3-pip ca-certificates iptables nftables \
    libtss2-esys-3.0.2-0 libtss2-mu0 libtss2-rc0 libtss2-tctildr0 \
    libtss2-tcti-device0 libtss2-tcti-swtpm0 libtss2-tcti-mssim0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /avon-agent /usr/local/bin/avon-agent
COPY deploy/compose/agent-entrypoint.sh /usr/local/bin/agent-entrypoint.sh
RUN chmod +x /usr/local/bin/agent-entrypoint.sh
# e2e runs as root to create TUN
ENTRYPOINT ["/usr/local/bin/agent-entrypoint.sh"]
