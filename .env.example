# AVON Environment Configuration
# Copy this file to .env and update values for your environment

# Database Configuration
DATABASE_URL=postgres://avon:avon_dev_password@localhost:5432/avon
POSTGRES_USER=avon
POSTGRES_PASSWORD=avon_dev_password
POSTGRES_DB=avon

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Control Plane Configuration
CONTROL_PLANE_PORT=8080

# Logging
LOG_LEVEL=info

# Authentication
# IMPORTANT: Change this in production!
JWT_SECRET=your_secure_jwt_secret_here_change_in_production

# Service Ports (for reference)
# Gateway UDP: 4600
# Auth gRPC: 50051
# CA gRPC: 50052
# Pulse gRPC: 50053
# Policy Engine: 8081
# Admin API: 8080
