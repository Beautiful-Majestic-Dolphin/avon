# Copy to .env before `docker compose up`. Every value below is required.

# PostgreSQL superuser password (database `avon`, user `avon`).
POSTGRES_PASSWORD=change-me-postgres

# Redis AUTH password.
REDIS_PASSWORD=change-me-redis

# First AVON owner account, created by the bootstrap job.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-admin

# Log level for every service (trace|debug|info|warn|error).
AVON_LOG_LEVEL=info
